{
  "schema_version": 1,
  "name": "routalk-pilot-core-v2",
  "description": "Provider-independent verification of the current canonical Routalk Pilot phone UI, queue, command observation, protected merge, command contracts/state, persistent store, processor, and exact production-verification surfaces.",
