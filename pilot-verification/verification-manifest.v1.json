{
  "schema_version": 1,
  "name": "routalk-pilot-core-v1",
  "description": "Provider-independent verification of the core Routalk Pilot mobile command, recovery, queue, merge, and production-verification surfaces.",
  "artifact_files": [
    "index.html",
    "resume.html",
    "pilot-recovery.js",
    "api/command.js",
    "api/dispatch.js",
    "api/merge.js",
    "api/queue.js",
    "api/resume-last.js",
    "api/status.js",
    "api/verify-production.js",
    "scripts/process-pilot-queue.js"
  ],
  "checks": [
    {
      "id": "index-exists",
      "type": "file_exists",
      "path": "index.html"
    },
    {
      "id": "resume-exists",
      "type": "file_exists",
      "path": "resume.html"
    },
    {
      "id": "recovery-exists",
      "type": "file_exists",
      "path": "pilot-recovery.js"
    },
    {
      "id": "pending-package-marker",
      "type": "contains",
      "path": "index.html",
      "text": "routalk-pilot.pending-package.v2"
    },
    {
      "id": "recovery-navigation-marker",
      "type": "contains",
      "path": "index.html",
      "text": "Test recovery navigation"
    },
    {
      "id": "resume-back-marker",
      "type": "contains",
      "path": "resume.html",
      "text": "Back to Pilot"
    },
    {
      "id": "dispatch-syntax",
      "type": "node_syntax",
      "path": "api/dispatch.js"
    },
    {
      "id": "command-syntax",
      "type": "node_syntax",
      "path": "api/command.js"
    },
    {
      "id": "merge-syntax",
      "type": "node_syntax",
      "path": "api/merge.js"
    },
    {
      "id": "queue-syntax",
      "type": "node_syntax",
      "path": "api/queue.js"
    },
    {
      "id": "resume-api-syntax",
      "type": "node_syntax",
      "path": "api/resume-last.js"
    },
    {
      "id": "status-syntax",
      "type": "node_syntax",
      "path": "api/status.js"
    },
    {
      "id": "production-verify-syntax",
      "type": "node_syntax",
      "path": "api/verify-production.js"
    },
    {
      "id": "queue-runner-syntax",
      "type": "node_syntax",
      "path": "scripts/process-pilot-queue.js"
    },
    {
      "id": "recovery-script-syntax",
      "type": "node_syntax",
      "path": "pilot-recovery.js"
    }
  ]
}
